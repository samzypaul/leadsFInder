# LOCAL SECRETS — gitignored, never committed. Rotate any value pasted into chat.

# ─── Database (Neon Postgres, pooled) ─────────────────────────────────────────
DATABASE_URL=

# ─── AI (Gemini) ──────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Scraping ─────────────────────────────────────────────────────────────────
SCRAPER_MODE=fallback
RESPECT_ROBOTS=true

# ─── Auth / security ──────────────────────────────────────────────────────────
AUTH_ENABLED=true
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_EMAIL=
ADMIN_PASSWORD=changeme

# ─── App ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
DEFAULT_COUNTRY=Tanzania
