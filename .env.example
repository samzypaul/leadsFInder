# ─── Database ────────────────────────────────────────────────────────────────
# Postgres (used by docker-compose). Leave unset to fall back to local SQLite.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ─── AI provider (Gemini primary, OpenAI optional) ───────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Which provider to prefer: gemini | openai | fallback
AI_PROVIDER=gemini

# ─── Search (Google Custom Search JSON API) ──────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ─── Scraping ────────────────────────────────────────────────────────────────
# live    -> use Playwright/httpx against real pages (requires `playwright install`)
# fallback-> use bundled fixtures + httpx best-effort (default, safe, offline)
SCRAPER_MODE=fallback
RESPECT_ROBOTS=true
SCRAPER_USER_AGENT=LeadHunterTZ/1.0 (+https://example.com/bot)
SCRAPER_TIMEOUT_SECONDS=20
# Politeness delay between requests to the same host (seconds)
SCRAPER_MIN_DELAY=2

# ─── App ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
DEFAULT_COUNTRY=Tanzania

# ─── Auth / security ─────────────────────────────────────────────────────────
AUTH_ENABLED=true
# CHANGE THIS in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-in-production-please-set-SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Default admin provisioned on first boot — change before deploying!
ADMIN_EMAIL=admin@leadhunter.tz
ADMIN_PASSWORD=changeme

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
